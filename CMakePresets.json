{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-vs",
      "displayName": "Windows Visual Studio",
      "description": "Visual Studio generator for Windows development and debugging",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VOICE_RUNTIME_ENABLE_WEBRTC_APM": "ON",
        "VOICE_RUNTIME_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "macos-xcode",
      "displayName": "macOS Xcode",
      "description": "Generate Xcode project for macOS development and debugging",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build-xcode-mac",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VOICE_RUNTIME_ENABLE_WEBRTC_APM": "ON",
        "VOICE_RUNTIME_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "ios-xcode",
      "displayName": "iOS Xcode",
      "description": "Generate Xcode project for iOS cross-compilation and debugging",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build-xcode-ios",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_BUILD_TYPE": "Debug",
        "VOICE_RUNTIME_ENABLE_WEBRTC_APM": "ON",
        "VOICE_RUNTIME_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux-native",
      "displayName": "Linux Native",
      "description": "Native build for Linux development and debugging",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-linux-native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VOICE_RUNTIME_ENABLE_WEBRTC_APM": "ON",
        "VOICE_RUNTIME_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "android-ndk-arm64",
      "displayName": "Android NDK arm64-v8a",
      "description": "Cross-compile for Android arm64-v8a using Android NDK under Linux",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-android-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-21",
        "VOICE_RUNTIME_ENABLE_WEBRTC_APM": "ON",
        "VOICE_RUNTIME_BUILD_TESTS": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ]
}
