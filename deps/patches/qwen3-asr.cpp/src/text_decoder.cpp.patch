 bool TextDecoder::load_tensor_data(const std::string & path, struct gguf_context * ctx) {
+#if defined(_WIN32)
+    HANDLE hFile = CreateFileA(path.c_str(), GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (hFile == INVALID_HANDLE_VALUE) {
+        error_msg_ = "Failed to open file for mmap: " + path;
+        return false;
+    }
+    
+    LARGE_INTEGER size;
+    if (!GetFileSizeEx(hFile, &size)) {
+        error_msg_ = "Failed to get file size: " + path;
+        CloseHandle(hFile);
+        return false;
+    }
+    
+    HANDLE hMapping = CreateFileMappingA(hFile, NULL, PAGE_READONLY, 0, 0, NULL);
+    if (hMapping == NULL) {
+        error_msg_ = "Failed to create file mapping: " + path;
+        CloseHandle(hFile);
+        return false;
+    }
+    
+    void * mmap_addr = MapViewOfFile(hMapping, FILE_MAP_READ, 0, 0, 0);
+    CloseHandle(hMapping);
+    CloseHandle(hFile);
+    
+    if (mmap_addr == NULL) {
+        error_msg_ = "Failed to map view of file: " + path;
+        return false;
+    }
+    
+    size_t st_size = static_cast<size_t>(size.QuadPart);
+#else
