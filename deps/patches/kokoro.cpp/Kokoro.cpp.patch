+    // Try to enable CUDA provider if available
+    bool cuda_available = false;
+    try {
+        auto providers = Ort::GetAvailableProviders();
+        for (const auto& provider : providers) {
+            if (provider == "CUDAExecutionProvider") {
+                cuda_available = true;
+                break;
+            }
+        }
+    } catch (...) {}
+
+    if (cuda_available) {
+        try {
+            OrtCUDAProviderOptions options;
+            options.device_id = 0;
+            session_options.AppendExecutionProvider_CUDA(options);
+            std::cout << "[Kokoro] CUDA Execution Provider enabled successfully." << std::endl;
+        } catch (const std::exception& e) {
+            std::cerr << "[Kokoro] Failed to enable CUDA execution provider: " << e.what() << std::endl;
+        }
+    } else {
+        std::cout << "[Kokoro] CUDA Execution Provider not available. Running on CPU." << std::endl;
+    }
